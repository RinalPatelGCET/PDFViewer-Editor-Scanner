<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context="com.smartpdfsuite.fragments.OrganizerFragment">

    <!-- Header -->
    <TextView
        android:id="@+id/txt_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="All PDFs"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_pdf_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"

        app:layout_constraintTop_toBottomOf="@id/txt_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/search_bg"
        app:boxStrokeWidth="0dp"

        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp"

        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/search_icon"
        app:startIconMinSize="24dp"

        app:endIconMode="clear_text"
        app:endIconTint="@color/search_icon"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_pdf_edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search PDFs"
            android:singleLine="true"
            android:inputType="text"

            android:textColor="@color/search_text"
            android:textColorHint="@color/search_hint"

            android:background="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </com.google.android.material.textfield.TextInputLayout>



    <!-- Sort Section -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/sort_chip_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/search_pdf_layout"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sort_date"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:checked="true"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sort_name"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sort_size"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size"/>

    </com.google.android.material.chip.ChipGroup>

    <!-- PDF List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/all_pdfs_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/sort_chip_group"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_pdf_document"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/no_all_pdfs_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_pdf_empty"
            android:contentDescription="No PDFs"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No PDFs found"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_pdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Scan PDF"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_scan"
            app:iconPadding="8dp"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"/>

        <!--        <com.google.android.material.button.MaterialButton-->
<!--            android:id="@+id/btn_scan_pdf"-->
<!--            android:layout_marginTop="16dp"-->
<!--            android:text="Scan PDF"-->
<!--            style="@style/Widget.Material3.Button.Filled"/>-->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>






