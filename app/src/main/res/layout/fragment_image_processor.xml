<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/text_background_new">

    <!-- ================= TOP BAR ================= -->

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_light"
            android:padding="14dp"
            android:src="@drawable/ic_back"/>

        <!-- Title -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review Scan"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjust, enhance and create your PDF"
                android:textColor="#7A7A7A"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Magic -->
      <!--  <ImageButton
            android:id="@+id/btn_magic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_light"
            android:padding="12dp"
            android:src="@drawable/ic_magic"/>-->
    </LinearLayout>


    <!-- ================= IMAGE CARD ================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/image_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeColor="#FFB7BC"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/rotate_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/captured_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
    </androidx.cardview.widget.CardView>


    <!-- ================= ROTATE CARD ================= -->

    <LinearLayout
        android:id="@+id/rotate_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rotate_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="26dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toBottomOf="@id/image_card"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LEFT -->
        <LinearLayout
            android:id="@+id/btn_rotate_left"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_rotate_left"
                android:tint="@color/red"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Left"
                android:textColor="@color/text"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="18dp"
            android:background="#F1DCDC"/>

        <!-- RIGHT -->
        <LinearLayout
            android:id="@+id/btn_rotate_right"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_rotate_right"
                android:tint="@color/red"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Right"
                android:textColor="@color/text"
                android:textSize="14sp"/>
        </LinearLayout>

    </LinearLayout>


    <!-- ================= FILTER PANEL ================= -->

    <LinearLayout
        android:id="@+id/filter_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_bottom_panel"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/rotate_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Filters -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filter_recycler"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"/>

        <!-- Create PDF -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_pdf_button"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="18dp"
            android:text="Create PDF"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:icon="@drawable/nic_pdf"
            app:backgroundTint="@color/red"
            app:cornerRadius="30dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            />
    </LinearLayout>


    <!-- ================= LOADER ================= -->

    <ProgressBar
        android:id="@+id/processing_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>



